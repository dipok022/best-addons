{
  "name": "best-addons",
  "version": "1.0.0",
  "description": "Folder-extractor build for Best Addons: manifest-driven module assets plus the admin and widget-builder spines",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "extract": "node build/extract.mjs",
    "extract:check": "node build/extract.mjs --check",
    "dev": "npm run extract && vite",
    "watch": "npm run extract && vite build --watch",
    "build": "npm run extract && vite build",
    "prod": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint:php": "find includes modules tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:php": "php tests/runtime.php",
    "check": "npm run typecheck && npm run test && npm run build && npm run lint:php && npm run test:php && npm run extract:check"
  },
  "author": "Dipok Roy",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "sass": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
